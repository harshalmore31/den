{
  "name": "den-agent",
  "version": "0.1.0-alpha.2",
  "description": "Den CLI — the living runtime for AI agents. Connects to local Docker agents and remote deployed agents (Northflank, Cloudflare, etc.) from one terminal. Pairs with the den-agent Python runtime on PyPI.",
  "type": "module",
  "license": "Apache-2.0",
  "author": {
    "name": "Harshal More",
    "email": "harshalmore2468@gmail.com"
  },
  "homepage": "https://github.com/harshalmore31/den#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshalmore31/den.git",
    "directory": "packages/den-cli"
  },
  "bugs": {
    "url": "https://github.com/harshalmore31/den/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "agent-framework",
    "cli",
    "den",
    "llm",
    "claude",
    "openai",
    "ink",
    "react",
    "typescript"
  ],
  "bin": {
    "den": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "esbuild src/index.tsx --bundle --platform=node --target=node18 --format=esm --outfile=dist/cli.mjs --packages=external --banner:js='#!/usr/bin/env node'",
    "build:bun": "bun build src/index.tsx --outfile dist/cli.mjs --target node --minify",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && chmod +x dist/cli.mjs"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "ink": "^5.2.0",
    "react": "^18.3.1",
    "yaml": "^2.8.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18"
  }
}
